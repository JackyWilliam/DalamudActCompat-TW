<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <ItemGroup>
    <!-- Compile the actual scanner with the same Win32 generator, but keep
         handle corruption regressions out of the other smoke-test processes. -->
    <Compile Include="../../vendor/IINACT/IINACT/Network/MultiSigScanner.cs" Link="MultiSigScanner.cs" />
    <!-- The 7.57 receive-signature resolver belongs to the CN/Global IINACT; IINACT-TW keeps
         its own Taiwan ZoneDown path, so this checkout has neither the resolver nor its test. -->
    <Compile Remove="ZoneDownSignatureSmokeTests.cs" Condition="!Exists('../../vendor/IINACT/IINACT/Network/ZoneDownSignatureResolver.cs')" />
    <Compile Include="../../vendor/IINACT/IINACT/Network/ZoneDownSignatureResolver.cs" Link="ZoneDownSignatureResolver.cs" Condition="Exists('../../vendor/IINACT/IINACT/Network/ZoneDownSignatureResolver.cs')" />
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.183" PrivateAssets="all" />
    <None Update="Fixtures/not-an-image.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
